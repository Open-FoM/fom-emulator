{
  "name": "servermanager",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "predev": "powershell -NoProfile -Command \"$p=Get-NetTCPConnection -LocalPort 5173 -ErrorAction SilentlyContinue | Select-Object -ExpandProperty OwningProcess -Unique; if($p){$p|%{Stop-Process -Id $_ -Force -ErrorAction SilentlyContinue}}; exit 0\"",
    "dev": "concurrently -k \"vite --port 5173 --strictPort\" \"wait-on tcp:5173 && electron .\"",
    "gen:packets": "tsx scripts/gen_packet_templates.ts",
    "build": "vite build",
    "preview": "vite preview",
    "lint:tsc": "tsc -p tsconfig.json --noEmit",
    "lint:eslint": "eslint \"**/*.{ts,tsx,js,cjs,mjs}\" --max-warnings=0",
    "lint": "npm run lint:tsc && npm run lint:eslint",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitejs/plugin-react": "^4.2.1",
    "concurrently": "^8.2.2",
    "electron": "^30.0.0",
    "eslint": "^9.10.0",
    "eslint-config-prettier": "^9.1.0",
    "@typescript-eslint/eslint-plugin": "^8.7.0",
    "@typescript-eslint/parser": "^8.7.0",
    "prettier": "^3.3.3",
    "tsx": "^4.7.0",
    "typescript": "^5.3.0",
    "vite": "^5.0.0",
    "wait-on": "^7.2.0"
  }
}
