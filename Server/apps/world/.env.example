# FoM World Server Configuration
# Copy this file to .env and adjust values as needed.

# UDP listen port for the world server
PORT=62000

# Max incoming client connections
MAX_CONNECTIONS=100

# Drop idle client connections after this many ms
CONNECTION_TIMEOUT_MS=60000

# Drop clients that stop sending heartbeat (0x6B) after this many ms
HEARTBEAT_TIMEOUT_MS=20000

# Drop connections that never send a heartbeat after this many ms
PRE_HEARTBEAT_TIMEOUT_MS=20000

# Relay client heartbeat to master at most once per this interval (ms)
HEARTBEAT_RELAY_MS=2000

# Hint for master UDP port (excludes master from client heartbeat timeouts)
MASTER_PORT=61000

# Master host for heartbeat relays (blank = rely on discovery queries)
MASTER_HOST=

# RakNet connection password (must match client)
SERVER_PASSWORD=37eG87Ph

# Default world ID to use when clients send 0 (fallback)
WORLD_ID=1

# Public IP advertised to master (blank = echo sender)
WORLD_PUBLIC_IP=

# Default world instance (currently unused; keep at 0 for safety)
WORLD_INST=0

# CSV source for world service spawns (terminals, etc.)
# WORLD_SERVICES_CSV=Server/data/world_services_single_terminal.csv

# Global debug logging
DEBUG=1

# Allow raw (unreliable) passthrough IDs that bypass RakNet reliability
RAW_PASSTHROUGH_IDS=0x09

# Enable local admin control plane (HTTP/WS)
ADMIN_ENABLED=1

# Admin WS/HTTP port (localhost only)
ADMIN_PORT=4702

# Admin auth token (GUI must match)
ADMIN_TOKEN=dev-admin-token

# Shared discovery token (must match master)
WORLD_DISCOVERY_TOKEN=dev-world-token

# Optional profile label (shown in GUI)
ADMIN_PROFILE_NAME=

# Suppress most console output
QUIET_MODE=0

# Packet log mode: off | summary | full
PACKET_LOG=full

# Minimum console log interval in ms
PACKET_LOG_INTERVAL_MS=5000

# Enable packet log file output (Server/apps/world/logs)
PACKET_LOG_FILE=1

# Log file name (defaults to fom_server.log)
LOG_FILE_NAME=

# Enable packet log analysis/aggregation
PACKET_LOG_ANALYSIS=0

# Suppress duplicate console packet logs within this ms window
PACKET_LOG_REPEAT_SUPPRESS_MS=2000

# Packet log flush mode: off | login | always
PACKET_LOG_FLUSH=off

# Capture raw socket packets before RakNet parsing
PACKET_LOG_RAW=1
PACKET_LOG_RAW_RECV=1
PACKET_LOG_RAW_SEND=1
PACKET_LOG_RAW_ONLY=1
PACKET_LOG_RAW_MAX_QUEUE=4096
PACKET_LOG_RAW_MAX_BYTES=4096

# Trace reliable unwrap decisions (debug)
# PACKET_LOG_RELIABLE_TRACE=0
# PACKET_LOG_RELIABLE_TRACE_MS=1000

# Optional log profile (matches hook-style profiles)
# PACKET_LOG_PROFILE=Default
# PACKET_LOG_PROFILE_DEFAULT_ALL=@1500
# PACKET_LOG_PROFILE_DEFAULT_RAKRECV=0x08,0x0A@2000
# PACKET_LOG_PROFILE_DEFAULT_RAKSEND=0x80,0x00,0x40,0xC0@2000
# PACKET_LOG_PROFILE_DEFAULT_LITHSEND=0x03,0x00@2500
# PACKET_LOG_PROFILE_QUIET_ALL=@4000
# PACKET_LOG_PROFILE_QUIET_RAKRECV=0x08,0x0A!
# PACKET_LOG_PROFILE_QUIET_RAKSEND=0x80,0x00,0x40,0xC0@5000
# PACKET_LOG_PROFILE_QUIET_LITHSEND=0x03,0x00@5000

# Filter packet IDs for console logging (comma-separated hex or decimal, e.g., 0x6C,0x6D)
# PACKET_LOG_IDS=

# Filter packet IDs for file logging (comma-separated hex or decimal)
# PACKET_LOG_FILE_IDS=

# Ignore these packet IDs entirely (comma-separated hex or decimal)
PACKET_LOG_IGNORE_IDS=0x7E,0x6B
