# FoM Master Server Configuration
# Copy this file to .env and adjust values as needed.

# UDP listen port for the master server
PORT=61000

# Max incoming client connections
MAX_CONNECTIONS=100

# Drop idle client connections after this many ms
CONNECTION_TIMEOUT_MS=60000

# Drop authenticated sessions if world heartbeat relay goes silent for this many ms
MASTER_HEARTBEAT_TIMEOUT_MS=20000

# RakNet connection password (must match client)
SERVER_PASSWORD=37eG87Ph

# Server mode: master or world
SERVER_MODE=master

# World server allowlist for discovery (comma-separated ip:port)
WORLD_SERVERS=127.0.0.1:62000

# Shared discovery token (must match world server)
WORLD_DISCOVERY_TOKEN=dev-world-token

# Discovery query interval in ms
WORLD_DISCOVERY_INTERVAL_MS=5000

# Drop world entries older than this (ms)
WORLD_DISCOVERY_STALE_TTL_MS=15000

# Global debug logging
DEBUG=1

# Enable local admin control plane (HTTP/WS)
ADMIN_ENABLED=1

# Admin WS/HTTP port (localhost only)
ADMIN_PORT=4701

# Admin auth token (GUI must match)
ADMIN_TOKEN=dev-admin-token

# Optional profile label (shown in GUI)
ADMIN_PROFILE_NAME=

# Verbose login logging
LOGIN_DEBUG=0

# Enable strict login validation (invalid/outdated credentials -> status codes)
LOGIN_STRICT=1

# Require password hash in 0x6E (else return 0x6F INCORRECT_PASSWORD)
LOGIN_REQUIRE_CREDENTIALS=0

# Allow 0x6E without prior 0x6C (bypass 0x6D gate)
ACCEPT_AUTH_WITHOUT_USER=0

# Re-send 0x6D on duplicate 0x6C while pending
RESEND_DUPLICATE_6D=0

# Enforce exact clientVersion (0 disables)
LOGIN_CLIENT_VERSION=1853

# Reset authenticated connections back to CONNECTED if they try to log in again while not in-world
LOGIN_RESET_DELAY_MS=3000

# Legacy default worldId (used only if discovery returns no worlds)
WORLD_ID=1

# World instance sent in travel (0 uses client/default)
WORLD_INST=0

# Force playerId sent in travel/0x6F (0 uses connection id)
WORLD_SELECT_PLAYER_ID=0

# Randomize playerId when WORLD_SELECT_PLAYER_ID=0
WORLD_SELECT_PLAYER_ID_RANDOM=0

# Account type sent in 0x6F (0=FREE,1=BASIC,2=PREMIUM,3=ADMIN)
LOGIN_ACCOUNT_TYPE=0

# Full account flag (enables restricted UI options)
LOGIN_IS_FULL_ACCOUNT=0

# Character data flags bit (SharedMem[0x1DE7E])
LOGIN_HAS_CHAR_FLAGS=0

# Suppress most console output
QUIET_MODE=0

# Packet log mode: off | summary | full
PACKET_LOG=full

# Minimum console log interval in ms
PACKET_LOG_INTERVAL_MS=5000

# Enable packet log file output (Server/apps/master/logs)
PACKET_LOG_FILE=1

# Log file name (defaults to fom_server.log)
LOG_FILE_NAME=

# Enable packet log analysis/aggregation
PACKET_LOG_ANALYSIS=0

# Suppress duplicate console packet logs within this ms window
PACKET_LOG_REPEAT_SUPPRESS_MS=2000

# Packet log flush mode: off | login | always
PACKET_LOG_FLUSH=off

# Capture raw socket packets before RakNet parsing
PACKET_LOG_RAW=1
PACKET_LOG_RAW_RECV=1
PACKET_LOG_RAW_SEND=1
PACKET_LOG_RAW_ONLY=1
PACKET_LOG_RAW_MAX_QUEUE=4096
PACKET_LOG_RAW_MAX_BYTES=4096

# Trace reliable unwrap decisions (debug)
# PACKET_LOG_RELIABLE_TRACE=0
# PACKET_LOG_RELIABLE_TRACE_MS=1000

# Optional log profile (matches hook-style profiles)
# PACKET_LOG_PROFILE=Default
# PACKET_LOG_PROFILE_DEFAULT_ALL=@1500
# PACKET_LOG_PROFILE_DEFAULT_RAKRECV=0x08,0x0A@2000
# PACKET_LOG_PROFILE_DEFAULT_RAKSEND=0x80,0x00,0x40,0xC0@2000
# PACKET_LOG_PROFILE_DEFAULT_LITHSEND=0x03,0x00@2500
# PACKET_LOG_PROFILE_QUIET_ALL=@4000
# PACKET_LOG_PROFILE_QUIET_RAKRECV=0x08,0x0A!
# PACKET_LOG_PROFILE_QUIET_RAKSEND=0x80,0x00,0x40,0xC0@5000
# PACKET_LOG_PROFILE_QUIET_LITHSEND=0x03,0x00@5000

# Filter packet IDs for console logging (comma-separated hex or decimal, e.g., 0x6C,0x6D)
# PACKET_LOG_IDS=

# Filter packet IDs for file logging (comma-separated hex or decimal)
# PACKET_LOG_FILE_IDS=

# Ignore these packet IDs entirely (comma-separated hex or decimal)
PACKET_LOG_IGNORE_IDS=0x7E
