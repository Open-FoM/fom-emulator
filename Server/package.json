{
  "name": "openfom-server",
  "private": true,
  "workspaces": ["packages/*", "apps/*"],
  "scripts": {
    "dev:master": "bun run --cwd apps/master dev",
    "dev:world": "bun run --cwd apps/world dev",
    "start:master": "bun run --cwd apps/master start",
    "start:world": "bun run --cwd apps/world start",
    "build:native": "cd packages/networking/native && build.bat",
    "typecheck": "bun run --cwd packages/utils typecheck && bun run --cwd packages/networking typecheck && bun run --cwd packages/packets typecheck && bun run --cwd apps/master typecheck && bun run --cwd apps/world typecheck",
    "lint": "eslint \"**/*.{ts,tsx}\"",
    "lint:fix": "eslint \"**/*.{ts,tsx}\" --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/node": "latest",
    "typescript": "^5.3.0",
    "@typescript-eslint/eslint-plugin": "^8.11.0",
    "@typescript-eslint/parser": "^8.11.0",
    "eslint": "^9.12.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.3.3"
  }
}
